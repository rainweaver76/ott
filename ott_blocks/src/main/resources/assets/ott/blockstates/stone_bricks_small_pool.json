{
    "multipart": [
        { "apply": { "model": "ott:block/stone_bricks/stone_bricks_small_pool_floor" } },
        { "when": { "north": "false" }, "apply": { "model": "ott:block/stone_bricks/stone_bricks_small_pool_side", "y": 180 } },
        { "when": { "east":  "false" }, "apply": { "model": "ott:block/stone_bricks/stone_bricks_small_pool_side", "y": 270 } },
        { "when": { "south": "false" }, "apply": { "model": "ott:block/stone_bricks/stone_bricks_small_pool_side"            } },
        { "when": { "west":  "false" }, "apply": { "model": "ott:block/stone_bricks/stone_bricks_small_pool_side", "y":  90 } },
        { "when": { "has_pillar": "true" }, "apply": { "model": "ott:block/stone_bricks/stone_bricks_small_pool_pillar" } },
        { "when": { "bottom": "true" },     "apply": { "model": "ott:block/stone_bricks/stone_bricks_small_pool_bottom"  } },
        { "when": { "level": "1" }, "apply": { "model": "ott:block/water/pool_water_11px" } },
        { "when": { "level": "2" }, "apply": { "model": "ott:block/water/pool_water_12px" } },
        { "when": { "level": "3" }, "apply": { "model": "ott:block/water/pool_water_13px" } },
        { "when": { "level": "4" }, "apply": { "model": "ott:block/water/pool_water_14px" } },
        { "when": { "level": "5" }, "apply": { "model": "ott:block/water/pool_water_15px" } },
        { "when": { "level": "6" }, "apply": { "model": "ott:block/water/pool_water_16px" } }
    ]
}
